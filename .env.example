MAILCODE_REQUEST_TIMEOUT="20"
MAILCODE_CHANNEL_WAIT_SECONDS="60"

# 省流量模式下，在连接上游代理前阻断浏览器后台下载（含子域名）；填 [] 关闭
BROWSER_DATA_SAVER_BLOCKED_PROXY_HOSTS="dl.google.com\ngvt1.com"

# 协议 HTTP 后端：curl_cffi / wreq（wreq 需要 Python >=3.11）；新会话生效
# 影响纯协议注册及后台 2FA 等 BrowserSession，不改变 Roxy 浏览器注册
PROTOCOL_HTTP_CLIENT="curl_cffi"
# 两个后端独立保存桌面浏览器协议指纹；可选值以 Web 下拉列表（已安装版本）为准
CURL_CFFI_IMPERSONATE="chrome146"
WREQ_EMULATION="chrome146"

# Tiger SMS（启用时设置 SMS_PROVIDER="tiger"，SMS_SERVICE="dr"；国家按平台国家表填写）
TIGER_SMS_API_BASE="https://api.tiger-sms.com/stubs/handler_api.php"
TIGER_SMS_API_KEY=""
